  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"spring\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{job=\"spring\"}, env)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "prod",
          "value": "prod"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "앱 재기동",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#8F6FE8",
        "expr": "changes(process_start_time_seconds{env=\"$env\"}[1m]) > 0",
        "titleFormat": "앱 재기동",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "type": "alertlist",
      "title": "발화 중인 알림",
      "id": 18,
      "description": "이 환경에서 지금 울리고 있는 알림. 대시보드 상단의 환경 선택과 같은 기준으로 걸러진다 — prod 를 보는 화면에 dev 알림이 섞이면 어디를 봐야 하는지 흐려진다.",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
