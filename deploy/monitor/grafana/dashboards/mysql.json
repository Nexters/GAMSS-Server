        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mysql_global_status_threads_connected{env=\"$env\"} / clamp_min(mysql_global_variables_max_connections{env=\"$env\"}, 1) * 100",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
