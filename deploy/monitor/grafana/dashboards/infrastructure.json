{
  "uid": "gamss-infra",
  "title": "3 · 서버 자원 (CPU·메모리·디스크)",
  "description": "서버 자원이 의심될 때, 또는 앱이 통째로 죽었을 때. 환경을 여러 개 골라 dev·prod·monitor 를 한 화면에서 비교한다.",
  "tags": [
    "gamss"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "30s",
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(up, env)",
          "refId": "env"
        },
        "definition": "label_values(up, env)",
        "refresh": 1,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "앱 재기동",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#8F6FE8",
        "expr": "changes(process_start_time_seconds{env=\"$env\"}[1m]) > 0",
        "titleFormat": "앱 재기동",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "서버 자원",
      "id": 32,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
