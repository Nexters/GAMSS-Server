    {
      "type": "timeseries",
      "title": "CPU 사용률",
      "id": 33,
      "description": "서버별 CPU 사용률. 세 서버를 한 패널에서 비교한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - avg by (server) (rate(node_cpu_seconds_total{env=~\"$env\", mode=\"idle\"}[$__rate_interval])) * 100",
          "legendFormat": "{{server}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "메모리 사용률",
      "id": 34,
      "description": "MemAvailable 기준(캐시는 여유로 친다). 모니터링 서버가 4GB 로 충분한지 판단하는 근거다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
