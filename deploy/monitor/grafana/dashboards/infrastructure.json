    {
      "type": "bargauge",
      "title": "디스크 여유 (남은 기간 예측)",
      "id": 37,
      "description": "최근 6시간 증가 속도가 유지될 때 디스크가 가득 차기까지 남은 시간. 값이 크면(수년) 사실상 늘지 않는다는 뜻이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D64550",
                "value": null
              },
              {
                "color": "#C99A06",
                "value": 604800
              },
              {
                "color": "#2E9E4F",
                "value": 2592000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "minVizHeight": 16,
        "minVizWidth": 8,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "predict_linear(node_filesystem_avail_bytes{env=~\"$env\", mountpoint=\"/\"}[6h], 0) / clamp_min(-deriv(node_filesystem_avail_bytes{env=~\"$env\", mountpoint=\"/\"}[6h]), 0.001)",
          "legendFormat": "{{server}}",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
