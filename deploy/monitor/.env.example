# gamss-monitor 서버의 ~/app/.env 템플릿.
# 실제 값은 서버에서 직접 채운다(이 파일은 예시라 레포에 있고, .env 는 커밋하지 않는다).

# Grafana admin 계정. 공인 IP 로 열려 있는 서비스라 값 관리는 GitHub 시크릿
# (GRAFANA_ADMIN_USER·GRAFANA_ADMIN_PASSWORD)을 정본으로 본다.
# 두 값 모두 컨테이너를 처음 띄울 때만 반영된다 — 운영 중 변경은 README 의 '계정 변경' 참고.
GRAFANA_ADMIN_USER=gamss
GRAFANA_ADMIN_PASSWORD=change-me

# 알림을 받을 Discord 채널의 웹훅 URL.
# 비워두면 컨택포인트 검증에 걸려 Grafana 가 아예 기동하지 않는다 — 알림이 조용히 빠지는 것보다
# 눈에 띄게 실패하는 쪽이라, 값을 채우기 전에는 스택을 올리지 않는다는 뜻이다.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# 이 서버의 사설 IP. Loki 수신 포트(3100)를 이 주소에만 바인딩한다.
# 비워두면 127.0.0.1 로 떨어져 dev·prod 가 로그를 보내지 못한다(외부 노출보다는 안전한 실패).
PRIVATE_IP=192.168.0.63
