# 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 git에 올라가지 않는다).

# ── 로컬 개발(권장) ─────────────────────────────────────────
# Firebase 없이 백엔드 dev-login 으로 로그인한다. 아래 두 줄이면 충분하다.
#   VITE_AUTH_MODE=mock
#   VITE_DEV_ADMIN_EMAIL=<허용목록(admin.emails)에 있는 이메일>
# 백엔드는 local 프로필로 띄우고(:8080), vite dev 서버가 /api 를 그쪽으로 프록시한다.

VITE_AUTH_MODE=mock
VITE_DEV_ADMIN_EMAIL=

# ── 배포(구글 로그인) ───────────────────────────────────────
# VITE_AUTH_MODE 를 비우고 아래 Firebase 웹 설정을 채운다(공개값이라 노출돼도 안전).
# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성에서 복사.
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gamss-cbdcb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gamss-cbdcb
VITE_FIREBASE_APP_ID=
