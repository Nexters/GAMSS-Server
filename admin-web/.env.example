# 이 파일을 .env.local 로 복사해 값을 채운다(.env.local 은 git에 올라가지 않는다).
# 배포(도커) 빌드에서는 같은 이름의 환경변수를 빌드 시점에 주입한다.

# 백엔드 API 주소. admin.gamss.kr 처럼 같은 도메인에 배포하면 비워두고 상대경로(/api)를 쓴다.
VITE_API_BASE_URL=

# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성에서 복사).
# apiKey 등은 공개값이라 프론트 번들에 포함되어도 안전하다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gamss-cbdcb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gamss-cbdcb
VITE_FIREBASE_APP_ID=
